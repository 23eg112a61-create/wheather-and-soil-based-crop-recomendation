# Server Configuration
PORT=5000
# Set to 'production' on Render
NODE_ENV=development
# Your deployed frontend URL (e.g., https://your-app.netlify.app)
FRONTEND_URL=

# Database Configuration
# In production on Render, replace with your MongoDB Atlas cloud URI
MONGODB_URI=mongodb://127.0.0.1:27017/crop-recommendation

# Authentication Secrets
# Generate a strong cryptographic key using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=892f8c47f08c0f78a8873b6a5d6034a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0

# External Weather APIs (Optional)
# If left blank, the system will fall back to high-fidelity simulated weather forecasting.
OPENWEATHER_API_KEY=
WEATHER_API_KEY=

# Email Configuration (Nodemailer SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_SECURE=false
